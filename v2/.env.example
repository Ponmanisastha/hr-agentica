# Copy to .env and fill in what you use. Real environment variables override this file. Never commit .env.

# Claude (optional). Without it the app uses Ollama if running, else the offline rules-only mode.
ANTHROPIC_API_KEY=
# Model tiers (LiteLLM model names)
HRAI_SMART_MODEL=anthropic/claude-sonnet-5-5
HRAI_FAST_MODEL=anthropic/claude-haiku-4-5-20251001
HRAI_LOCAL_MODEL=ollama_chat/llama3.1:8b
OLLAMA_API_BASE=http://localhost:11434
# auto | claude | local | mock
HRAI_MODE=auto

# Embeddings: auto (local MiniLM, ~80 MB download once) | ollama | hash
HRAI_EMBEDDINGS=auto

# Budgets in USD per month (per agent: HRAI_BUDGET_<AGENT>, e.g. HRAI_BUDGET_SCREENING=10)
HRAI_TOTAL_BUDGET=40

# Optional: route every model call through a LiteLLM proxy (gateway/litellm_proxy.yaml)
HRAI_GATEWAY_URL=
HRAI_GATEWAY_KEY=

# Ticket agent: GitHub repo for PRs (needs `gh auth login`). Leave empty to keep fixes local.
HRAI_GITHUB_REPO=Ponmanisastha/hr-agentica
HRAI_BASE_BRANCH=main
# 1 = start working a ticket as soon as it is created (otherwise the ticket_sweep trigger picks it up)
HRAI_TICKET_AUTOWORK=0

# A2A: call agents on another server instead of in-process
HRAI_A2A_URL=
HRAI_A2A_TOKEN=

# MCP server identity (python app.py token create <user>)
HRAI_MCP_TOKEN=
